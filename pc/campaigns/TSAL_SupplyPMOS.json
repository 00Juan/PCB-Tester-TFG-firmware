{
  "format": "pcbtester-campaign",
  "version": 1,
  "name": "TSAL",
  "description": "TSAL (Tractive System Active Light) \u2014 SupplyPMOS variant of TSAL.json. Wiring: CH1=HV_Accu_State, CH2=AIR-_AUX2, CH3=AIR-_Coil, CH4=SDC_END, CH5=Precharge_Coil, CH6=PRECHARGE_AUX2, CH7=AIR+_AUX2, CH8=AIR+_Coil, CH9(HP)=GreenLed (active-high: ON=>3V, OFF=0V), CH10(HP)=TSAL supply high-side switch (passes an external 12V rail wired to its input to the DUT V+ when connected; HP channels sense/pass only, they do not source voltage), CH11(HV)=DUT GND common return. The DUT supply is now controlled by CH10 (high-side switching) instead of CH11 (low-side switching); CH11 stays connected as the common GND return. 'pre' powers the DUT once (no latching -> no power-cycling between tests) and 'post' releases all relays. RedLed is no longer instrumented (CH10 reused as the supply high-side switch).",
  "pre": [
    {
      "cmd": "ch.limits",
      "ch": 9,
      "vmax": 15.0,
      "imax": 1.0
    },
    {
      "cmd": "ch.limits",
      "ch": 10,
      "vmax": 15.0,
      "imax": 1.0
    },
    {
      "cmd": "ch.connect",
      "ch": 9
    },
    {
      "cmd": "ch.connect",
      "ch": 10
    },
    {
      "cmd": "ch.connect",
      "ch": 11
    },
    {
      "cmd": "wait",
      "ms": 300
    }
  ],
  "post": [
    {
      "cmd": "ch.disconnect",
      "ch": 11
    },
    {
      "cmd": "ch.disconnect",
      "ch": 10
    },
    {
      "cmd": "ch.disconnect",
      "ch": 9
    }
  ],

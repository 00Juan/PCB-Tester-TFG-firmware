{
  "format": "pcbtester-campaign",
  "version": 1,
  "name": "TSAL_latching",
  "description": "TSAL latching variant — same DUT and wiring as TSAL.json (CH1=HV_Accu_State, CH2=AIR-_AUX2, CH3=AIR-_Coil, CH4=SDC_END, CH5=Precharge_Coil, CH6=PRECHARGE_AUX2, CH7=AIR+_AUX2, CH8=AIR+_Coil, CH9(HP)=GreenLed, CH10(HP)=RedLed, CH11(HV)=DUT GND return) but with latching behaviour: once an implausibility is detected the green LED is latched OFF and does NOT recover when the fault clears — a power-cycle is required. Each implausibility test uses settle_ms=1000 to verify the latch holds for 1 s; a power-cycle (disconnect CH11, wait 300 ms, reconnect CH11, wait 1000 ms) is prepended to the setup of every subsequent test to reset the board. Red is never energised (no HV on HV+): RedLed must stay OFF in every test.",
  "pre": [
    {
      "cmd": "ch.limits",
      "ch": 9,
      "vmax": 15.0,
      "imax": 1.0
    },
    {
      "cmd": "ch.limits",
      "ch": 10,
      "vmax": 15.0,
      "imax": 1.0
    },
    {
      "cmd": "ch.connect",
      "ch": 9
    },
    {
      "cmd": "ch.connect",
      "ch": 10
    },
    {
      "cmd": "ch.connect",
      "ch": 11
    },
    {
      "cmd": "wait",
      "ms": 1000
    }
  ],
  "post": [
    {
      "cmd": "ch.disconnect",
      "ch": 11
    },
    {
      "cmd": "ch.disconnect",
      "ch": 9
    },
    {
      "cmd": "ch.disconnect",
      "ch": 10
    }
  ],
  "tests": [
    {
      "name": "Safe: TS_is_OFF=1 Green ON",
      "type": "static_voltage",
      "setup": [
        { "step": "vs", "ch": 1, "v": 5.0 },
        { "step": "vs", "ch": 2, "v": 0.8 },
        { "step": "vs", "ch": 3, "v": 12.0 },
        { "step": "vs", "ch": 4, "v": 0.0 },
        { "step": "vs", "ch": 5, "v": 12.0 },
        { "step": "vs", "ch": 6, "v": 0.8 },
        { "step": "vs", "ch": 7, "v": 0.8 },
        { "step": "vs", "ch": 8, "v": 12.0 }
      ],
      "params": {
        "sense_mask": 0,
        "sense_hp_mask": 1,
        "expected_v": 1.5,
        "tolerance_v": 0.7,
        "settle_ms": 500
      }
    },
    {
      "name": "Safe: Red_On=0 Red OFF",
      "type": "static_voltage",
      "setup": [
        { "step": "vs", "ch": 1, "v": 5.0 },
        { "step": "vs", "ch": 2, "v": 0.8 },
        { "step": "vs", "ch": 3, "v": 12.0 },

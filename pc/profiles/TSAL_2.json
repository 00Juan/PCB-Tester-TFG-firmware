{
  "format": "pcbtester-dut-profile",
  "version": 1,
  "name": "TSAL_2",
  "description": "TSAL DUT profile. Wiring as in campaigns/TSAL.json: LVLP CH1-8 drive the control-loop signals, CH9/CH10 (HP) are the open-drain LED pull-ups vs the 12V rail (LED ON = ~0V at the pin, OFF = ~12V), CH11 (HV relay) switches the DUT GND return. LV supply is external.",
  "channels": {
    "1": "HV_Accu_State",
    "2": "AIR-_AUX2",
    "3": "AIR-_Coil",
    "4": "SDC_END",
    "5": "Precharge_Coil",
    "6": "PRECHARGE_AUX2",
    "7": "AIR+_AUX2",
    "8": "AIR+_Coil",
    "9": "GreenLed",
    "10": "RedLed",
    "11": "DUT_GND"
  },

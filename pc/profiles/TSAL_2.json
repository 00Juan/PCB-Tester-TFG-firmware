  "indicators": [
    {
      "name": "Green LED",
      "states": [
        {
          "state": "ON",
          "color": "#43a047",
          "when": [
            {
              "ch": 9,
              "field": "vout",
              "op": "<",
              "value": 2.0
            },
            {
              "ch": 9,
              "field": "conn",
              "op": "==",
              "value": 1
            }
          ]
        },
        {
          "state": "OFF",
          "color": "#546e7a",
          "when": [
            {
              "ch": 9,
              "field": "vout",
              "op": ">",
              "value": 10.0
            }
          ]
        }
      ],
      "fallback": {
        "state": "?",
        "color": "#fb8c00"
      }
    },
    {
